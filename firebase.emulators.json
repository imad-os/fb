{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/admin.html",
        "type": 302
      },
      {
        "source": "/index.html",
        "destination": "/admin.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/downloadSubtitle/**",
        "function": "downloadSubtitle",
        "region": "europe-west1"
      },
      {
        "source": "/fetchSubtitles/**",
        "function": "fetchSubtitles",
        "region": "europe-west1"
      },
      {
        "source": "/footballNews/**",
        "function": "footballNews",
        "region": "europe-west1"
      },
      {
        "source": "/footballRecommendations/**",
        "function": "footballRecommendations",
        "region": "europe-west1"
      },
      {
        "source": "/footballRequest/**",
        "function": "footballRequest",
        "region": "europe-west1"
      },
      {
        "source": "/getLocation/**",
        "function": "getLocation",
        "region": "europe-west1"
      },
      {
        "source": "/getRecommendations/**",
        "function": "getRecommendations",
        "region": "europe-west1"
      },
      {
        "source": "/searchTrailer/**",
        "function": "searchTrailer",
        "region": "europe-west1"
      },
      {
        "source": "/xtream",
        "function": "xtreamRequest",
        "region": "europe-west1"
      },
      {
        "source": "/xtream/**",
        "function": "xtreamRequest",
        "region": "europe-west1"
      }
    ],
    "headers": [
      {
        "source": "/admin.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}